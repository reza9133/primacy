# Copy to .env if you want to set these once. Nothing here is required.

# Override the Studionet RPC endpoint (default: https://studio.genlayer.com/api)
# PRIMACY_RPC_URL=https://studio.genlayer.com/api

# Live end-to-end run: eight comma separated private keys of pre-funded accounts. Needed only when the
# network refuses to fund throwaway accounts. Order: sponsor, sponsor2, h1, h2, h3, h4, h5, caller.
# PRIMACY_ACCOUNT_KEYS=0x...,0x...,0x...,0x...,0x...,0x...,0x...,0x...

# Deployment: deploy from your own funded account instead of a throwaway one.
# PRIMACY_DEPLOYER_KEY=0x...
